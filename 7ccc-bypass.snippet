# =====================================================
# 蜂鸟骑士 - 7c云卡密验证绕过（圈X Rewrite 重写规则）
# =====================================================
# 说明：
#   1. 请求为 HTTP 明文（非 HTTPS），无需 MITM / CA 证书。
#   2. api1 / api2 / api3 是冗余轮询，任意一个返回成功即通过，
#      所以一条规则通杀全部。
#   3. 本规则把 api*.7ccccccc.com 的响应交给 7ccc-bypass.js 改写，
#      强制返回「已授权」。
#
# 使用方法（重要）：
#   把下面两处 USERNAME 和 REPO 替换成你自己的 GitHub 用户名和仓库名，
#   然后把这个 .snippet 文件和 7ccc-bypass.js 一起传到该仓库根目录。
# =====================================================

[rewrite_local]

# 主规则：覆盖 api1 / api2 / api3 以及任意编号 api 子域的所有路径
^https?://api[0-9]*\.?7ccccccc\.com/.* script-response-body https://raw.githubusercontent.com/402971561/congenial-octo-doodle/main/7ccc-bypass.js

# 兜底规则：覆盖任意 7ccccccc.com 子域（防止域名变体漏网）
^https?://[a-z0-9\-\.]*7ccccccc\.com/.* script-response-body https://raw.githubusercontent.com/402971561/congenial-octo-doodle/main/7ccc-bypass.js
